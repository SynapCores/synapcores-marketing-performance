# SynapCores installs feed: refresh (daily via synapcores-installs-refresh.timer).
# Public data only: GitHub Actions + Azure CI ranges (for the export's CI rule) and the GitHub release download
# counters (github-downloads-v1.jsonl). No telemetry key, no access to the export's private row cache, the
# telemetry config, or the mktperf files. Needs outbound HTTPS to api.github.com and download.microsoft.com.
[Unit]
Description=SynapCores installs feed refresh (CI ranges + GitHub release downloads)
Documentation=file:///opt/synapcores-installs-feed/README.md
After=network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/var/lib/synapcores-installs-feed

[Service]
Type=oneshot
User=bitnami
Group=bitnami
UMask=0027
ExecStart=/usr/bin/python3 -I /opt/synapcores-installs-feed/synapcores_installs_feed.py refresh
StateDirectory=synapcores-installs-export
StateDirectoryMode=0700
ReadWritePaths=/var/lib/synapcores-installs-feed
InaccessiblePaths=-/var/lib/synapcores-installs-export/private -/etc/synapcores -/etc/mktperf -/var/lib/mktperf-app -/opt/mktperf -/opt/telemetry-ingest
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=384M
CPUQuota=50%
Nice=10
TimeoutStartSec=10min

# Performance Marketing app — copy to .env.local for local dev.

# The engine URL: :28080 for the docker-compose engine, or your own gateway.
SYNAPCORES_URL=http://127.0.0.1:28080

# Admin Bearer token the app uses to talk to the engine (mint in the engine UI).
SYNAPCORES_ADMIN_API_KEY=replace-me-with-a-real-aidb-key

FRAMEWORK_TENANT_KEYS_DIR=./var/tenant-keys

# Auth.js session-encryption secret. 32 random bytes: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-random-bytes
NEXTAUTH_URL=http://localhost:3005
MAIL_PROVIDER=console

# ── First-party pixel collector (optional) ──────────────────────────────────
# The pixel (public/track.js) posts batches to /api/v1/collect. Every batch
# must carry a valid site write-key — either the beacon's data-site-id, or an
# Authorization: Bearer sk_user_... header. Mint that key in the app at
# Settings → API keys, then drop the snippet on each domain you want to track
# (see the repo README, "Track your own sites").
#
# DEV ONLY: to exercise the collector locally without minting a key, set this
# to a tenant id and unkeyed batches resolve to it. It is IGNORED when
# NODE_ENV=production, so it can never become an open relay in prod.
# COLLECTOR_DEV_TENANT_ID=

# ── Sign-up policy ───────────────────────────────────────────────────────────
# Sign-up is invite-only by default. Comma-separated emails that may register
# and create a workspace (e.g. the first owner). Everyone else joins through
# an invitation from Team. SIGNUP_OPEN=true restores open demo sign-up.
# SIGNUP_ALLOWED_EMAILS=you@yourco.com
# SIGNUP_OPEN=false

# ── Visitor capture (pm_events) ──────────────────────────────────────────────
# Every pixel event is stored in pm_events with the client IP, IP-derived
# approximate location, parsed user agent and a bot / AI-crawler flag.
#
# PM_EVENTS_V2=1 stores the events in pm_events_v2 instead: the same columns
# without a primary key or index, because on SynapCores 2.5.1 every INSERT or
# UPDATE into a wide indexed table costs O(rows) in time and engine memory.
# On the first start with the flag, new events go to pm_events_v2 at once and
# pm_events is copied over in the background (resumable); pages switch when
# the copy is verified. pm_events stays as the rollback source (its IPs are
# still swept): unset the flag, `systemctl daemon-reload`, restart, then copy
# back the newer rows with `node bin/pm-events-v2.mjs --env <app.env>
# reverse-copy --apply`. Accepted values: 1, true, on, yes (any case).
# PM_EVENTS_V2=1
#
# Local GeoIP database (GeoIP2-City format). We use DB-IP "IP to City Lite"
# (CC BY 4.0, free, no signup; attribution is shown in the app footer). Fetch
# or refresh it with bin/update-geoip.sh. No external API is called per request;
# if the file is missing, events are stored without location.
# GEOIP_DB_PATH=/var/lib/mktperf/geoip/dbip-city-lite.mmdb
#
# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (Apache only → 1). The client IP is taken that many entries from the right;
# anything further left is client-supplied and ignored.
# TRUSTED_PROXY_HOPS=1
#
# IP retention: full IPs are kept this many days, then cut to /24 (IPv4) or
# /48 (IPv6) by a sweep that runs at boot and every IP_RETENTION_SWEEP_HOURS.
# IP_RETENTION_DAYS=90
# IP_RETENTION_SWEEP_HOURS=6
# IP_RETENTION_SWEEP=on        # 'off' to disable the in-app sweep
#
# Do Not Track / Global Privacy Control: batches carrying DNT: 1 or Sec-GPC: 1
# from these page hosts are dropped server-side ('*' = every site).
# COLLECT_PRIVACY_SIGNAL_HOSTS=renascai.com,www.renascai.com

# ── Report query cache ──────────────────────────────────────────────────
# Report SELECTs (dashboard, campaigns, attribution, creative, visitors, UTM
# campaigns, tables) are kept in a small in-process LRU for a few seconds, keyed
# by workspace + SQL + params, so repeated renders don't re-run the same heavy
# queries on the engine. Auth/session/token queries and writes are never cached;
# writes (ingest, rebuild, sample data, campaigns, pixel changes, background
# sweeps) clear it. New pixel events show up within the TTL.
# QUERY_CACHE_TTL_MS=30000            # 0 turns the cache off
# QUERY_CACHE_MAX_ENTRIES=200
# QUERY_CACHE_MAX_BYTES=16777216      # ~16 MiB of result data
# QUERY_CACHE_MAX_ENTRY_BYTES=2097152 # bigger results are not kept

# Performance Marketing app — copy to .env.local for local dev.

# The engine URL: :28080 for the docker-compose engine, or your own gateway.
SYNAPCORES_URL=http://127.0.0.1:28080

# Admin Bearer token the app uses to talk to the engine (mint in the engine UI).
SYNAPCORES_ADMIN_API_KEY=replace-me-with-a-real-aidb-key

FRAMEWORK_TENANT_KEYS_DIR=./var/tenant-keys

# Auth.js session-encryption secret. 32 random bytes: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-random-bytes
NEXTAUTH_URL=http://localhost:3005
MAIL_PROVIDER=console

# ── First-party pixel collector (optional) ──────────────────────────────────
# The pixel (public/track.js) posts batches to /api/v1/collect. Every batch
# must carry a valid site write-key — either the beacon's data-site-id, or an
# Authorization: Bearer sk_user_... header. Mint that key in the app at
# Settings → API keys, then drop the snippet on each domain you want to track
# (see the repo README, "Track your own sites").
#
# DEV ONLY: to exercise the collector locally without minting a key, set this
# to a tenant id and unkeyed batches resolve to it. It is IGNORED when
# NODE_ENV=production, so it can never become an open relay in prod.
# COLLECTOR_DEV_TENANT_ID=

# ── Sign-up policy ───────────────────────────────────────────────────────────
# Sign-up is invite-only by default. Comma-separated emails that may register
# and create a workspace (e.g. the first owner). Everyone else joins through
# an invitation from Team. SIGNUP_OPEN=true restores open demo sign-up.
# SIGNUP_ALLOWED_EMAILS=you@yourco.com
# SIGNUP_OPEN=false
